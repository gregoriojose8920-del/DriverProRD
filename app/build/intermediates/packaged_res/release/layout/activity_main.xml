<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A0E1A">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <ImageView android:layout_width="90dp" android:layout_height="90dp"
            android:src="@mipmap/ic_launcher" android:layout_gravity="center" android:layout_marginTop="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DriverPro" android:textSize="30sp" android:textStyle="bold"
            android:textColor="#2196F3" android:layout_gravity="center" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Asistente Inteligente para Conductores InDrive" android:textSize="12sp"
            android:textColor="#607D8B" android:layout_gravity="center" android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/tvTrips" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Viajes hoy: 0  |  Est: RD$0"
            android:textColor="#4CAF50" android:textSize="15sp" android:textStyle="bold"
            android:gravity="center" android:padding="14dp" android:background="#1A2035"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvOverlayStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Panel Flotante: INACTIVO"
            android:textColor="#FF5252" android:textSize="12sp" android:gravity="center" android:padding="3dp"/>
        <TextView android:id="@+id/tvAccessStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Accesibilidad: INACTIVA"
            android:textColor="#FF5252" android:textSize="12sp" android:gravity="center"
            android:padding="3dp" android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1A2035" android:padding="16dp" android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Bot Activo"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <Switch android:id="@+id/switchBot" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true"/>
        </LinearLayout>

        <Button android:id="@+id/btnOverlay" android:layout_width="match_parent"
            android:layout_height="46dp" android:text="Activar Panel Flotante"
            android:backgroundTint="#1565C0" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnAccessibility" android:layout_width="match_parent"
            android:layout_height="46dp" android:text="Configurar Accesibilidad"
            android:backgroundTint="#0D47A1" android:textColor="#FFFFFF" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FILTROS DE VIAJE" android:textColor="#2196F3"
            android:textStyle="bold" android:textSize="12sp" android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/etMinPrice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Precio minimo (RD$)"
            android:textColorHint="#546E7A" android:textColor="#FFFFFF"
            android:inputType="numberDecimal" android:backgroundTint="#2196F3"
            android:layout_marginBottom="8dp" android:paddingBottom="6dp"/>
        <EditText android:id="@+id/etMaxDist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Distancia maxima recojo (km)"
            android:textColorHint="#546E7A" android:textColor="#FFFFFF"
            android:inputType="numberDecimal" android:backgroundTint="#2196F3"
            android:layout_marginBottom="8dp" android:paddingBottom="6dp"/>
        <EditText android:id="@+id/etMinRating" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Calificacion minima pasajero"
            android:textColorHint="#546E7A" android:textColor="#FFFFFF"
            android:inputType="numberDecimal" android:backgroundTint="#2196F3"
            android:layout_marginBottom="12dp" android:paddingBottom="6dp"/>
        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="50dp" android:text="GUARDAR FILTROS"
            android:backgroundTint="#2196F3" android:textColor="#FFFFFF"
            android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnSetup" android:layout_width="match_parent"
            android:layout_height="50dp" android:text="ASISTENTE DE CONFIGURACION"
            android:backgroundTint="#4A148C" android:textColor="#CE93D8"
            android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnMapa" android:layout_width="match_parent"
            android:layout_height="50dp" android:text="VER MAPA / HEATMAP / ZONAS"
            android:backgroundTint="#1A237E" android:textColor="#82B1FF"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnStats" android:layout_width="match_parent"
            android:layout_height="50dp" android:text="VER ESTADISTICAS DEL DIA"
            android:backgroundTint="#1B5E20" android:textColor="#A5D6A7"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnSuscripcion" android:layout_width="match_parent"
            android:layout_height="50dp" android:text="PLANES Y SUSCRIPCION"
            android:backgroundTint="#37474F" android:textColor="#90CAF9"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>
</ScrollView>