<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelTitle"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E61A1A2E"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DriverPro"
            android:textColor="#2196F3"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Switch
            android:id="@+id/switchActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inactivo"
        android:textColor="#FF4444"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtAlerta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Esperando viaje..."
        android:textColor="#FFCC00"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:background="#33FFCC00"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Precio minimo (RD$)"
        android:textColor="#AAAAAA"
        android:textSize="11sp"/>

    <EditText
        android:id="@+id/inputMinPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Ej: 150"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:singleLine="true"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Distancia recogida (km)"
        android:textColor="#AAAAAA"
        android:textSize="11sp"/>

    <EditText
        android:id="@+id/inputMaxPickup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Ej: 5"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:singleLine="true"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Distancia viaje (km)"
        android:textColor="#AAAAAA"
        android:textSize="11sp"/>

    <EditText
        android:id="@+id/inputMaxDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Ej: 20"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:singleLine="true"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rating minimo"
        android:textColor="#AAAAAA"
        android:textSize="11sp"/>

    <EditText
        android:id="@+id/inputMinRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Ej: 4.0"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:singleLine="true"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSaveFilters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Guardar"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnMinimize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Minimizar"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>
