<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F0000000"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/panelTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="DriverPro" android:textColor="#2196F3"
            android:textStyle="bold" android:textSize="15sp"/>
        <Button android:id="@+id/btnMinimize" android:layout_width="32dp"
            android:layout_height="32dp" android:text="▼" android:textSize="10sp"
            android:backgroundTint="#222222" android:textColor="#FFFFFF" android:padding="0dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/panelContent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- INDICADOR ANIMADO -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:background="#1A2035" android:padding="8dp" android:layout_marginBottom="6dp">

            <TextView android:id="@+id/tvRadar" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="📡"
                android:textSize="22sp" android:layout_marginEnd="8dp"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="🔴 INACTIVO"
                    android:textColor="#FF5252" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvBuscando" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="En espera..."
                    android:textColor="#607D8B" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- PULSO ANIMADO - BARRA DE ACTIVIDAD -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="8dp"
            android:background="#1A2035" android:layout_marginBottom="6dp">
            <View android:id="@+id/viewPulse" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="0"
                android:background="#2196F3"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@android:color/transparent"/>
        </LinearLayout>

        <TextView android:id="@+id/tvTripCounter" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Viajes hoy: 0"
            android:textColor="#90CAF9" android:textSize="12sp"
            android:gravity="center" android:layout_marginBottom="2dp"/>

        <TextView android:id="@+id/tvGanancias" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Estimado: RD$0"
            android:textColor="#4CAF50" android:textSize="13sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tvLicencia" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Licencia: verificando..."
            android:textColor="#FF9800" android:textSize="10sp"
            android:gravity="center" android:layout_marginBottom="6dp"/>

        <Switch android:id="@+id/switchActive" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Bot Activo"
            android:textColor="#FFFFFF" android:layout_marginBottom="6dp"/>

        <EditText android:id="@+id/inputMinPrice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Precio min (RD$)"
            android:textColorHint="#555" android:textColor="#FFF"
            android:inputType="numberDecimal" android:backgroundTint="#2196F3"
            android:textSize="12sp" android:paddingBottom="4dp" android:layout_marginBottom="3dp"/>

        <EditText android:id="@+id/inputMaxDistance" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Dist. max recojo (km)"
            android:textColorHint="#555" android:textColor="#FFF"
            android:inputType="numberDecimal" android:backgroundTint="#2196F3"
            android:textSize="12sp" android:paddingBottom="4dp" android:layout_marginBottom="3dp"/>

        <EditText android:id="@+id/inputMinRating" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Rating min pasajero"
            android:textColorHint="#555" android:textColor="#FFF"
            android:inputType="numberDecimal" android:backgroundTint="#2196F3"
            android:textSize="12sp" android:paddingBottom="4dp" android:layout_marginBottom="6dp"/>

        <TextView android:id="@+id/txtAlerta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text=""
            android:textColor="#4CAF50" android:textSize="11sp"
            android:gravity="center" android:layout_marginBottom="4dp"/>

        <Button android:id="@+id/btnSaveFilters" android:layout_width="match_parent"
            android:layout_height="36dp" android:text="GUARDAR"
            android:backgroundTint="#2196F3" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>